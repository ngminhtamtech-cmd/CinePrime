extends layout
include mixins
block content
  section.container.section
    h1.page-title Lịch chiếu
    p.page-lead Chọn ngày, phim hoặc rạp để xem suất còn nhận đặt vé.
    form.filters(method="get")
      select(name="movieId" aria-label="Phim")
        option(value="") Tất cả phim
        each m in movieOptions
          option(value=m.id selected=selectedMovie == m.id)= m.title
      select(name="cinemaId" aria-label="Rạp")
        option(value="") Tất cả rạp / khu vực
        each c in cinemaOptions
          option(value=c.id selected=selectedCinema == c.id)= c.city + ' · ' + c.name
      input(type="date" name="date" value=selectedDate aria-label="Ngày chiếu")
      button.button(type="submit") Tìm suất chiếu
    +dateStrip()
    .show-list
      +showList(shows)
