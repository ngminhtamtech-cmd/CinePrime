extends operations
include mixins
block head
  link(rel="stylesheet" href="/css/staff.css?v=20261113c")
  script(src="/js/staff-nav.js?v=20261113c")
  script(src="/js/vendor/zxing-browser.min.js" defer)
block brandControls
  +staffNavToggle
block headerNav
  +staffTabs('checkin')
block content
  main#main.staff-board.checkin(data-showtime=selectedShow)
    h1.sr-only Soát vé tại rạp
    aside#staff-left.board-left(aria-label="Suất trong ngày")
      .col-head
        h2 Suất #{isToday ? 'hôm nay' : 'ngày ' + dayText}
        form#staff-selection.day-pick(method="get")
          label
            span.sr-only Đổi ngày soát vé
            input(type="date" name="date" value=day required)
      .day-nav
        a(href='/staff?date=' + prevDay) ← Ngày trước
        if !isToday
          a(href="/staff") Hôm nay
        a(href='/staff?date=' + nextDay) Ngày sau →
      p.col-note Mở soát 60 phút trước giờ chiếu, đóng 30 phút sau. Suất đang nhận khách tự được chọn.
      if shows.size() == 0
        p.line-empty Không có suất mở vận hành tại rạp trong ngày #{dayText}. Dùng “Ngày trước / Ngày sau” hoặc chọn ngày khác.
      else
        ol.show-day
          each s in shows
            if s.id == nowBefore
              li.now-mark(aria-label='Bây giờ ' + nowTime)
                span= nowTime
            li(class=s.phase)
              a(href='/staff?date=' + day + '&showtimeId=' + s.id data-show-link aria-current=selectedShow == s.id ? 'true' : false title=s.movieTitle + ' · ' + s.roomName + ' · ' + s.state)
                span.t= s.time
                span.m #{s.movieTitle} · #{s.roomName}
                span.p= s.phaseText
          if nowAtEnd
            li.now-mark(aria-label='Bây giờ ' + nowTime)
              span= nowTime
    section.board-mid(aria-label="Kiểm tra vé")
      .show-head
        if selectedShow
          h2 #{selected.time} · #{selected.movieTitle}
          p
            span #{selected.roomName} · soát #{selected.window}
            span.sep ·
            span#selected-show-state= selected.state
        else
          h2 Chưa chọn suất
          p= shows.size() == 0 ? 'Ngày này chưa có suất để soát. Ô quét mã mở khi có suất.' : 'Chọn một suất ở cột trái để mở ô quét mã.'
      form#manual-lookup.scan
        label(for="ticket-code") Quét QR hoặc gõ mã vé / mã đơn
        .scan-row
          input#ticket-code(required placeholder="T-… hoặc CP-…" autocomplete="off" spellcheck="false" disabled=!selectedShow)
          button.btn.dark(type="submit" disabled=!selectedShow) Tra cứu
        p.hint Máy quét cầm tay: quét rồi tự Enter. Gõ tay: nhập mã vé (T-…) hoặc mã đơn (CP-…) rồi Enter.
      .scan-body
        .camera
          .camera-frame
            video#qr-video(playsinline muted hidden)
            p#camera-placeholder.camera-idle Camera chưa bật
          .camera-actions
            button#start-camera.btn(type="button" disabled=!selectedShow) Bật camera
            button#stop-camera.btn(type="button" hidden) Tắt camera
          p#camera-state.hint(role="status")= selectedShow ? 'Camera cần localhost hoặc HTTPS và quyền truy cập.' : 'Chọn suất trước khi bật camera.'
        .result
          #scan-result.verdict-area(aria-live="polite" aria-atomic="false")
            p.line-empty= selectedShow ? 'Sẵn sàng. Quét hoặc nhập mã để kiểm tra vé.' : 'Kết quả kiểm tra hiện ở đây sau khi chọn suất và quét mã.'
          .scan-next
            button#next-ticket.btn(type="button" disabled) Quét vé tiếp
            span.hint Enter cũng chuyển sang vé tiếp. Mỗi vé chỉ vào một lần.
    aside.board-right(aria-label="Vé theo suất")
      .col-head
        h2 Vé của suất
        span#staff-updated.hint(role="status")= selectedShow ? 'Cập nhật ' + ticketData.updatedAt.substring(0, 5) : 'Chưa chọn suất'
      .strip.four
        div
          span Hiệu lực
          strong(data-stat="total" class=!selectedShow || ticketData.summary.total == 0 ? "zero" : "")= !selectedShow || ticketData.summary.total == 0 ? "—" : ticketData.summary.total
        div
          span Đã vào
          strong(data-stat="used" class=!selectedShow || ticketData.summary.used == 0 ? "zero" : "")= !selectedShow || ticketData.summary.used == 0 ? "—" : ticketData.summary.used
        div
          span Chưa vào
          strong(data-stat="valid" class=!selectedShow || ticketData.summary.valid == 0 ? "zero" : "")= !selectedShow || ticketData.summary.valid == 0 ? "—" : ticketData.summary.valid
        div
          span Tỉ lệ vào
          strong(data-stat="rate" class=!selectedShow || ticketData.summary.used == 0 ? "zero" : "")= !selectedShow || ticketData.summary.used == 0 ? "—" : ticketData.summary.rate
      p.strip-note Hiệu lực = vé chưa huỷ. Tỉ lệ = đã vào / hiệu lực.
      form#staff-ticket-filter.filter-row
        input(name="q" placeholder="Tìm ghế, mã vé, mã đơn" aria-label="Tìm ghế, mã vé hoặc mã đơn" autocomplete="off" disabled=!selectedShow)
        select(name="state" aria-label="Trạng thái vé" disabled=!selectedShow)
          option(value="") Tất cả
          option(value="VALID") Chưa vào
          option(value="USED") Đã vào
          option(value="VOID") Vô hiệu
        button.btn(type="submit" disabled=!selectedShow) Lọc
      table.ledger
        thead
          tr
            th Ghế
            th Mã vé · đơn
            th Trạng thái
            th.num Lúc vào
        tbody#staff-ticket-rows
          if selectedShow
            each t in ticketData.tickets
              tr
                td.seat-cell= t.seat
                td.codes
                  span.mono= t.code
                  span.mono.dim= t.orderCode
                td
                  span.state(class=t.status == 'USED' ? 'used' : t.status == 'VOID' ? 'void' : 'valid')= t.status == 'USED' ? 'Đã vào' : t.status == 'VOID' ? 'Vô hiệu' : 'Chưa vào'
                td.num= t.when.length() > 0 ? t.when.substring(0, 5) : '—'
      p#staff-ticket-empty.line-empty(hidden=selectedShow && ticketData.tickets.size() > 0)= selectedShow ? 'Suất này chưa có vé được phát hành.' : 'Danh sách vé hiện sau khi chọn suất.'
      .pager
        span#staff-page-label= !selectedShow ? '—' : ticketData.total == 0 ? '0 vé' : (ticketData.total <= 25 ? '1–' + ticketData.total : '1–25') + ' / ' + ticketData.total
        span
          button#staff-prev.link(type="button" disabled) ← Trước
          |  ·
          button#staff-next.link(type="button" disabled=!selectedShow || !ticketData.hasMore) Sau →
