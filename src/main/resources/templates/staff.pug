extends operations
include mixins
block head
  link(rel="stylesheet" href="/css/staff.css?v=20261112")
  script(src="/js/staff-nav.js?v=20261112")
  script(src="/js/vendor/zxing-browser.min.js" defer)
block brandControls
  +staffNavToggle
block content
  .staff-shell
    +staffTabs('checkin')
    main#main.staff-main.checkin
      h1.sr-only Soát vé tại rạp
      .checkin-bar
        form.checkin-select#staff-selection(method="get")
          label.date-field
            span Ngày
            input(type="date" name="date" value=day required)
          label.show-field
            span Suất chiếu · ưu tiên suất đang nhận khách
            select(name="showtimeId")
              option(value="")= shows.size() == 0 ? '— Không có suất trong ngày —' : '— Chọn suất để bắt đầu —'
              each s in shows
                option(value=s.id selected=selectedShow == s.id) #{s.movieTitle} · #{s.roomName} · #{s.when} · #{s.state}
          button.button.secondary(type="submit") Chọn suất
        if selectedShow
          section.selected-show(aria-label="Suất đang soát")
            div
              small SUẤT ĐANG SOÁT
              strong(title=selected.movieTitle)= selected.movieTitle
              span #{selected.roomName} · #{selected.when}
            div
              span#selected-show-state.badge= selected.state
              small Check-in #{selected.window}
        else
          p.selected-show.pending= shows.size() == 0 ? 'Không có suất mở vận hành tại rạp phụ trách trong ngày này. Hãy chọn ngày khác.' : 'Chưa chọn suất. Chọn phim, phòng và giờ bên trái trước khi quét vé.'
      #staff-workspace.checkin-grid(data-showtime=selectedShow)
        section.panel.scan-panel
          .panel-heading
            h2 Kiểm tra vé
            span#camera-state.badge Chưa bật camera
          .camera-frame
            video#qr-video(playsinline muted hidden)
            #camera-placeholder
              span.scan-symbol(aria-hidden="true") ▣
              strong Quét mã QR vé
              p Đưa mã QR vào camera hoặc nhập mã bên dưới.
            .camera-actions
              button#start-camera.button(type="button" disabled=!selectedShow) Bật camera
              button#stop-camera.button.secondary(type="button" hidden) Tắt camera
          form#manual-lookup
            label(for="ticket-code") Mã vé hoặc mã đơn
            .manual-row
              input#ticket-code(required placeholder="T-… hoặc CP-…" autocomplete="off" disabled=!selectedShow)
              button.button.secondary(type="submit" disabled=!selectedShow) Tra cứu
          p.muted Dùng camera, máy quét hoặc bàn phím. Enter chỉ tra cứu mã.
        section.panel.scan-results
          .panel-heading
            h2 Kết quả kiểm tra
            button#next-ticket.button.secondary(type="button" disabled=!selectedShow) Quét vé tiếp
          #scan-result(aria-live="polite" aria-atomic="false")
            .empty= selectedShow ? 'Sẵn sàng tra cứu. Kết quả sẽ được giữ để kiểm tra và xác nhận từng vé.' : 'Chọn suất chiếu trước khi tra cứu vé.'
        section.panel.ticket-panel
          .staff-stats
            article.kpi-card
              span Còn hiệu lực
              strong(data-stat="total")= selectedShow ? ticketData.summary.total : '—'
            article.kpi-card
              span Đã vào
              strong(data-stat="used")= selectedShow ? ticketData.summary.used : '—'
            article.kpi-card
              span Chưa vào
              strong(data-stat="valid")= selectedShow ? ticketData.summary.valid : '—'
            article.kpi-card
              span Tỷ lệ
              strong(data-stat="rate")= selectedShow ? ticketData.summary.rate : '—'
          .panel-heading
            h2 Vé theo suất
            span#staff-updated.refresh-status(role="status")= selectedShow ? 'Cập nhật: ' + ticketData.updatedAt : 'Chưa chọn suất'
          form#staff-ticket-filter.ticket-filter
            input(name="q" placeholder="Mã vé / đơn / ghế" aria-label="Tìm mã vé, mã đơn hoặc ghế" disabled=!selectedShow)
            select(name="state" aria-label="Trạng thái vé" disabled=!selectedShow)
              option(value="") Tất cả
              option(value="VALID") Chưa vào
              option(value="USED") Đã vào
              option(value="VOID") Vô hiệu
            button.button.secondary(type="submit" disabled=!selectedShow) Lọc
          .table-wrap
            table.staff-ticket-table
              thead
                tr
                  th Vé / Đơn
                  th Ghế
                  th Trạng thái
                  th Check-in
              tbody#staff-ticket-rows
                if selectedShow
                  each t in ticketData.tickets
                    tr
                      td
                        strong= t.code
                        small= t.orderCode
                      td= t.seat
                      td
                        span.badge= t.statusLabel
                      td= t.when
            #staff-ticket-empty.empty(hidden=selectedShow && ticketData.tickets.size() > 0)= selectedShow ? 'Suất này chưa có vé được phát hành.' : 'Danh sách sẽ hiển thị sau khi chọn suất.'
          .ops-pagination
            span#staff-page-label= selectedShow ? 'Trang 1 · ' + ticketData.total + ' kết quả' : '—'
            .actions
              button#staff-prev.button.secondary(type="button" disabled aria-label="Trang trước") ←
              button#staff-next.button.secondary(type="button" disabled=!selectedShow || !ticketData.hasMore aria-label="Trang sau") →
