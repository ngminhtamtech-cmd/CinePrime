mixin csrf()
  input(type="hidden" name=csrfName value=csrfToken)
mixin chevron(direction)
  svg(viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false")
    path(d=direction == 'left' ? 'M15 18l-6-6 6-6' : 'M9 18l6-6-6-6')
mixin pagination()
  nav.ops-pagination.pager(aria-label="Phân trang" data-single=page == 0 && !hasMore ? 'true' : 'false')
    span.pager-info Trang #{page + 1} / #{(total + 4) / 5 > 0 ? (total + 4) / 5 : 1} · #{total} kết quả
    .actions.pager-arrows
      if page > 0
        a.pager-btn(href='?page=' + (page - 1) data-page=page - 1 aria-label="Trang trước" title="Trang trước")
          +chevron('left')
      else
        button.pager-btn(type="button" disabled aria-label="Trang trước")
          +chevron('left')
      if hasMore
        a.pager-btn(href='?page=' + (page + 1) data-page=page + 1 aria-label="Trang sau" title="Trang sau")
          +chevron('right')
      else
        button.pager-btn(type="button" disabled aria-label="Trang sau")
          +chevron('right')
mixin widgetPager(data, refresh, moreUrl)
  nav.ops-pagination.pager.widget-pager(aria-label="Phân trang khối" data-single=data.page == 0 && !data.hasMore ? 'true' : 'false')
    .pager-arrows
      button.pager-btn(type="button" data-widget-prev disabled aria-label="Trang trước" title="Trang trước")
        +chevron('left')
      span.pager-count(data-widget-page title=data.total + ' kết quả') #{data.page + 1} / #{(data.total + 4) / 5 > 0 ? (data.total + 4) / 5 : 1}
      button.pager-btn(type="button" data-widget-next disabled=!data.hasMore aria-label="Trang sau" title="Trang sau")
        +chevron('right')
    .pager-tools
      if refresh
        button.pager-btn.widget-refresh(type="button" data-widget-refresh aria-label="Làm mới khối" title="Làm mới")
          svg(viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false")
            path(d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7")
      if moreUrl
        a.widget-more(href=moreUrl) Xem tất cả
          +chevron('right')
  p.refresh-status(data-widget-status role="status")
mixin operationWidget(name, data, moreUrl)
  .operation-widget(data-op-widget=name data-cinema=cinemaId data-next=data.nextCursor data-revision=data.revision)
    .operation-list(data-widget-rows)
      each item in data.rows
        a.operation-item(href=item.href ? item.href : (name == 'upcoming' ? '/admin/manage/showtimes/edit?id=' : '/admin/orders/') + item.id data-record-id=item.recordId)
          strong= item.label
          small= item.detail
      if data.rows.size() == 0
        p.muted.empty-inline Không có mục nào lúc này.
    +widgetPager(data, true, moreUrl)
mixin sectionPagination(data, param)
  nav.ops-pagination.pager(aria-label="Phân trang chi tiết" data-single=data.page == 0 && !data.hasMore ? 'true' : 'false')
    span.pager-info Trang #{data.page + 1} · #{data.total} kết quả
    .actions.pager-arrows
      if data.page > 0
        a.pager-btn(href='?' + param + '=' + (data.page - 1) data-page=data.page - 1 data-page-param=param aria-label="Trang trước")
          +chevron('left')
      else
        button.pager-btn(type="button" disabled aria-label="Trang trước")
          +chevron('left')
      if data.hasMore
        a.pager-btn(href='?' + param + '=' + (data.page + 1) data-page=data.page + 1 data-page-param=param aria-label="Trang sau")
          +chevron('right')
      else
        button.pager-btn(type="button" disabled aria-label="Trang sau")
          +chevron('right')
mixin movieCard(m)
  article.movie-card(class=m.ended ? 'is-ended' : '' aria-disabled=m.ended ? 'true' : false)
    if m.ended
      .poster
        img(src=m.poster alt=m.title loading="lazy")
        span.age(class='age-' + m.ageRating)= m.ageRating
        span.ended-ribbon Đã kết thúc
    else
      a.poster(href='/movies/' + m.slug tabindex="-1" aria-hidden="true")
        img(src=m.poster alt="" loading="lazy")
        span.age(class='age-' + m.ageRating)= m.ageRating
        if m.comingSoon
          span.release-ribbon Khởi chiếu #{m.releaseText}
    .movie-card-body
      .movie-card-text
        if m.ended
          h3= m.title
          p.movie-card-meta Đã hết lịch chiếu
        else
          h3
            a(href='/movies/' + m.slug)= m.title
          p.movie-card-meta #{m.genres} · #{m.duration} phút
      +favButton(m)
    if !m.ended
      .card-actions
        if m.hasBookableShows
          a.button.small(href='/movies/' + m.slug + '#schedule')= m.comingSoon ? 'Đặt trước' : 'Mua vé'
        a.button.secondary.small(href='/movies/' + m.slug) Xem chi tiết
mixin favButton(m)
  - liked = viewer && favoriteIds && favoriteIds.contains(m.id)
  if viewer
    form.fav-form(action='/account/favorites/' + m.id method="post")
      input(type="hidden" name=csrfName value=csrfToken)
      input(type="hidden" name="next" value=currentUrl)
      button.fav(type="submit" aria-pressed=liked ? 'true' : 'false' aria-label=(liked ? 'Bỏ thích ' : 'Thích ') + m.title)
        svg(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
          path(d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z")
  else
    a.fav(href="/login" aria-label='Đăng nhập để thích ' + m.title)
      svg(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
        path(d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z")
mixin showList(shows)
  if shows.size() == 0
    .empty Không có suất chiếu phù hợp. Hãy chọn ngày hoặc rạp khác.
  each s in shows
    article.show-row
      div
        a(href='/movies/' + s.movieSlug)
          strong= s.movieTitle
        p #{s.cinemaName} · #{s.roomName} · #{s.city}
        small #{s.format} · #{s.language}
      if s.canHold
        a.show-time(href='/booking/' + s.id)= s.when
      else
        span.badge Đã ngừng nhận đặt vé
mixin dateStrip()
  .date-strip
    each d in days
      a(href=d.href class=d.selected ? 'active' : '' aria-current=d.selected ? 'date' : false)
        span= d.weekday
        strong= d.day
mixin contentCard(c, kindLabel)
  if c.image
    a.content-card(href='/content/' + c.slug)
      img.content-image(src=c.image alt="" loading="lazy")
      h3= c.title
      if c.dateText
        span.content-date= c.dateText
  else
    a.content-card.is-text(href='/content/' + c.slug)
      span.content-kind= kindLabel
      h3= c.title
      if c.excerpt
        p= c.excerpt
      if c.dateText
        span.content-date= c.dateText
mixin bookingSteps(current)
  ol.booking-steps(aria-label="Các bước đặt vé")
    each step, i in ['Chọn suất', 'Chọn ghế', 'Combo & thanh toán', 'Nhận vé']
      li(class=i + 1 < current ? 'done' : '' aria-current=i + 1 == current ? 'step' : false)
        span.step-name= step
mixin staffNavToggle
  .nav-controls
    button#staff-nav-toggle.nav-control(type="button" aria-label="Ẩn / hiện cột trái" title="Ẩn / hiện cột trái (Ctrl + B)" aria-controls="staff-left" aria-expanded="true")
      svg(viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false")
        rect(x="3" y="4.5" width="18" height="15" rx="3")
        path(d="M9 4.5v15")
    button#nav-back.nav-control(type="button" aria-label="Quay lại trang trước" title="Quay lại (Alt + ←)")
      svg(viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false")
        path(d="M15 18l-6-6 6-6")
    button#nav-forward.nav-control(type="button" aria-label="Tới trang sau" title="Tới (Alt + →)")
      svg(viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false")
        path(d="M9 18l6-6-6-6")
mixin staffTabs(active)
  nav.staff-tabs(aria-label="Chức năng nhân viên")
    a(href="/staff" aria-current=active != 'counter' ? 'page' : false) Soát vé
    a(href="/staff/counter" aria-current=active == 'counter' ? 'page' : false) Bán vé tại quầy
