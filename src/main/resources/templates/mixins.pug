mixin csrf()
  input(type="hidden" name=csrfName value=csrfToken)
mixin pagination()
  nav.ops-pagination(aria-label="Phân trang")
    span Trang #{page + 1} · #{total} kết quả
    .actions
      if page > 0
        a.button.secondary(href='?page=' + (page - 1) data-page=page - 1) ← Trước
      else
        button.button.secondary(type="button" disabled) ← Trước
      if hasMore
        a.button.secondary(href='?page=' + (page + 1) data-page=page + 1) Sau →
      else
        button.button.secondary(type="button" disabled) Sau →
mixin widgetPager(data, refresh, moreUrl)
  nav.ops-pagination(aria-label="Phân trang khối")
    span(data-widget-page) Trang #{data.page + 1} · #{data.total} kết quả
    .actions
      button.button.secondary(type="button" data-widget-prev disabled) ← Trước
      button.button.secondary(type="button" data-widget-next disabled=!data.hasMore) Sau →
      if refresh
        button.text-button.widget-refresh(type="button" data-widget-refresh aria-label="Làm mới khối" title="Làm mới khối") ↻
      if moreUrl
        a.widget-more(href=moreUrl) Xem đủ →
  p.refresh-status(data-widget-status role="status")
mixin operationWidget(name, data, moreUrl)
  .operation-widget(data-op-widget=name data-cinema=cinemaId data-next=data.nextCursor data-revision=data.revision)
    .operation-list(data-widget-rows)
      each item in data.rows
        a.operation-item(href=(name == 'upcoming' ? '/admin/manage/showtimes/edit?id=' : '/admin/orders/') + item.id data-record-id=item.recordId)
          strong= item.label
          small= item.detail
      if data.rows.size() == 0
        p.muted Chưa có dữ liệu cần hiển thị.
    +widgetPager(data, true, moreUrl)
mixin sectionPagination(data, param)
  nav.ops-pagination(aria-label="Phân trang chi tiết")
    span Trang #{data.page + 1} · #{data.total} kết quả
    .actions
      if data.page > 0
        a.button.secondary(href='?' + param + '=' + (data.page - 1) data-page=data.page - 1 data-page-param=param) ← Trước
      else
        button.button.secondary(type="button" disabled) ← Trước
      if data.hasMore
        a.button.secondary(href='?' + param + '=' + (data.page + 1) data-page=data.page + 1 data-page-param=param) Sau →
      else
        button.button.secondary(type="button" disabled) Sau →
mixin movieCard(m)
  article.movie-card(class=m.ended ? 'is-ended' : '' aria-disabled=m.ended ? 'true' : false)
    if m.ended
      .poster
        img(src=m.poster alt=m.title loading="lazy")
        span.age= m.ageRating
        span.ended-ribbon Đã kết thúc
    else
      a.poster(href='/movies/' + m.slug)
        img(src=m.poster alt=m.title loading="lazy")
        span.age= m.ageRating
        span.score ★ #{m.score}
        if m.comingSoon
          span.release-ribbon Khởi chiếu #{m.releaseText}
        span.poster-cta Xem chi tiết →
    .movie-card-body
      if m.ended
        h3= m.title
        p #{m.genres} · #{m.duration} phút
        span.book-link.disabled Đã hết lịch chiếu
      else
        a(href='/movies/' + m.slug)
          h3= m.title
        p #{m.genres} · #{m.duration} phút
        a.book-link(href='/movies/' + m.slug)= m.hasBookableShows ? (m.comingSoon ? 'ĐẶT TRƯỚC →' : 'MUA VÉ →') : 'KHÁM PHÁ →'
mixin showList(shows)
  if shows.size() == 0
    .empty Không có suất chiếu phù hợp. Hãy chọn ngày hoặc rạp khác.
  each s in shows
    article.show-row
      div
        a(href='/movies/' + s.movieSlug)
          strong= s.movieTitle
        p #{s.cinemaName} · #{s.roomName} · #{s.city}
        small #{s.format} · #{s.language}
      if s.canHold
        a.show-time(href='/booking/' + s.id)= s.when
      else
        span.badge Đã ngừng nhận đặt vé
mixin dateStrip()
  .date-strip
    each d in days
      a(href=d.href class=d.selected ? 'active' : '')= d.label
