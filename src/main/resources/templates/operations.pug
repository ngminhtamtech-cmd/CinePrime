doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="csrf-token" content=csrfToken)
    meta(name="csrf-header" content=csrfHeader)
    title= title
    - var staffUi = !navItems && viewer != null && viewer.role == 'STAFF'
    link(rel="icon" href="/images/cineprime-mark.svg" type="image/svg+xml")
    if !staffUi
      link(rel="stylesheet" href="/css/app.css")
      link(rel="stylesheet" href="/css/operations.css?v=20261113c")
    if navItems
      link(rel="stylesheet" href="/css/admin-ui.css")
      script(src="/js/admin-nav-pref.js")
    script(src="/js/app.js" defer)
    script(src="/js/operations.js?v=20261113d" defer)
    if navItems
      script(src="/js/admin.js" defer)
      script(src="/js/admin-editor.js" defer)
      script(src="/js/admin-dialog.js" defer)
      script(src="/js/admin-setup.js" defer)
      script(src="/js/showtime-calendar.js" defer)
      script(src="/js/showtime-editor.js" defer)
      link(rel="stylesheet" href="/css/showtime-editor.css")
      if adminForm
        script(src="/js/admin-forms.js" defer)
      if seatWorkspace
        script(src="/js/seat-3d.js" defer)
        script(src="/js/admin-workspace.js?v=20261113c" defer)
    block head
    if navItems
      link(rel="stylesheet" href="/css/admin-sheet.css?v=20261113j")
  body.operations(class=navItems ? (seatWorkspace ? 'admin-compact seat-workspace' : 'admin-compact') : (staffUi ? 'staff-ui' : '') data-admin-id=navItems && viewer ? viewer.id : false)
    a.skip(href="#main") Đi đến nội dung
    header.ops-header
      .ops-brand
        if navItems
          .nav-controls
            button#open-sidebar.nav-control(type="button" aria-label="Ẩn / hiện thanh điều hướng" title="Ẩn / hiện thanh điều hướng (Ctrl + B)" aria-expanded="false" aria-controls="ops-sidebar")
              svg(viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false")
                rect(x="3" y="4.5" width="18" height="15" rx="3")
                path(d="M9 4.5v15")
            button#nav-back.nav-control.nav-history(type="button" aria-label="Quay lại trang trước" title="Quay lại (Alt + ←)")
              svg(viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false")
                path(d="M15 18l-6-6 6-6")
            button#nav-forward.nav-control.nav-history(type="button" aria-label="Tới trang sau" title="Tới (Alt + →)")
              svg(viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false")
                path(d="M9 18l6-6-6-6")
        block brandControls
        a.brand(href=navItems ? '/admin' : '/staff' aria-label="CinePrime điều hành")
          img.brand-symbol(src="/images/cineprime-mark.svg" alt="" width="32" height="32")
          span Cine
            strong Prime
        block headerNav
        if !staffUi
          span.ops-role= operationsRole
      .ops-account
        if staffCinema
          strong.ops-cinema= staffCinema
        if navItems
          //- Admin: account and sign-out live at the bottom of the sidebar (admin/layout.pug)
          a.ops-site.button.secondary(href="/" target="_blank" rel="noopener")
            svg(viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false")
              path(d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5")
            span Xem website
        else
          if !staffUi
            a.ops-site(href="/" target="_blank" rel="noopener") Xem website ↗
          if viewer
            span.ops-user= viewer.name
          form(action="/logout" method="post")
            input(type="hidden" name=csrfName value=csrfToken)
            button.text-button(type="submit") Đăng xuất
    #ops-session.session-banner(role="alert" hidden)
      span Phiên không còn hợp lệ. Nội dung đang xem được giữ; hãy đăng nhập lại để tiếp tục.
      a(href="/login") Đăng nhập lại →
    block content
    #toast(role="status" aria-live="polite")
