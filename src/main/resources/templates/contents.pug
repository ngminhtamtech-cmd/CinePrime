extends layout
include mixins
block content
  section.container.section
    h1.page-title= title
    p.page-lead= kindLabel == 'Ưu đãi' ? 'Chương trình khuyến mãi và quyền lợi thành viên đang áp dụng.' : 'Tin tức, câu chuyện hậu trường và gợi ý xem phim.'
    .content-grid.section-gap
      each c in contents
        +contentCard(c, kindLabel)
    if contents.size() == 0
      .empty Chưa có nội dung mới.
