extends layout
include mixins
block content
  section.container.section
    .eyebrow KHÁM PHÁ CÂU CHUYỆN MỚI
    h1 Phim tại CinePrime
    form.filters(action="/movies" method="get" data-auto-movie-filter)
      input(name="q" value=q placeholder="Tên phim" aria-label="Tên phim")
      select(name="status" aria-label="Trạng thái")
        option(value="") Tất cả phim
        option(value="NOW_SHOWING" selected=selectedStatus == 'NOW_SHOWING') Đang chiếu
        option(value="COMING_SOON" selected=selectedStatus == 'COMING_SOON') Sắp chiếu
        option(value="ENDED" selected=selectedStatus == 'ENDED') Vừa kết thúc
      select(name="genre" aria-label="Thể loại")
        option(value="") Tất cả thể loại
        each g in genres
          option(value=g.id selected=selectedGenre == g.id)= g.name
      select(name="age" aria-label="Phân loại tuổi")
        option(value="") Mọi độ tuổi
        each a in ['P','K','T13','T16','T18']
          option(value=a selected=selectedAge == a)= a
      input(type="date" name="date" value=selectedDate aria-label="Ngày chiếu")
      button.button(type="submit") TÌM PHIM
    p.filter-summary(role="status")
      strong #{movies.size()} phim
      span  · #{q ? 'Tên: ' + q + ' · ' : ''}#{selectedStatus == 'COMING_SOON' ? 'Sắp chiếu' : selectedStatus == 'NOW_SHOWING' ? 'Đang chiếu' : selectedStatus == 'ENDED' ? 'Vừa kết thúc' : 'Mọi trạng thái'}
      each g in genres
        if selectedGenre == g.id
          span  · #{g.name}
      if selectedAge
        span  · #{selectedAge}
      if selectedDate
        span  · #{selectedDate}
    .movie-grid
      each m in movies
        +movieCard(m)
    if movies.size() == 0
      .empty Không có phim phù hợp. Hãy thử bộ lọc khác.
