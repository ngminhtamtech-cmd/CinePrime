extends operations
include mixins
block head
  link(rel="stylesheet" href="/css/staff.css?v=20261113c")
  script(src="/js/staff-nav.js?v=20261113c")
  script(src="/js/counter.js?v=20261113c" defer)
block brandControls
  +staffNavToggle
block headerNav
  +staffTabs('counter')
block content
  main#main.staff-counter
    h1.sr-only Bán vé tại quầy
    if notice
      p.flash(role="status")= notice
    if actionError
      p.flash.bad(role="alert")= actionError
    if !hasShift
      section.shift-open
        h2 Mở ca bán vé
        p Đếm tiền lẻ có sẵn trong két rồi nhập số tiền đầu ca. Hệ thống cộng tiền mặt thu trong ca để đối chiếu khi đóng ca.
        form(action="/staff/counter/shift/open" method="post")
          +csrf()
          label(for="opening-cash") Tiền đầu ca (đồng)
          .inline
            input#opening-cash.num(name="openingCash" inputmode="numeric" pattern="[0-9]*" required placeholder="500000" autocomplete="off")
            button.btn.primary(type="submit") Mở ca
        if lastClosed
          p.hint
            | Ca gần nhất đóng lúc #{lastClosed.closed} · chênh lệch #{lastClosed.difference} ·
            a(href='/staff/counter/shifts/' + lastClosed.id) Xem phiếu tổng kết
    else
      section.shift-bar(aria-label="Ca đang mở")
        span.sq.live(aria-hidden="true")
        strong Ca ##{shift.id} đang mở từ #{shift.openedTime}
        span Đơn
          b#shift-orders= shift.orders
        span Vé
          b#shift-tickets= shift.tickets
        span Tiền mặt trong két
          b#shift-expected= shift.expected
        .shift-links
          button#orders-open.link(type="button" aria-controls="orders-drawer" aria-haspopup="dialog") Đơn trong ca
          details#close-shift.close-shift(open=closeCounted ? true : false)
            summary.link Đóng ca
            form.pop(action="/staff/counter/shift/close" method="post")
              +csrf()
              h2 Đóng ca ##{shift.id}
              p.hint Đếm toàn bộ tiền trong két, gồm #{shift.openingCash} đầu ca. Hệ thống dự kiến #{shift.expected}.
              label(for="counted-cash") Tiền đếm được (đồng)
              input#counted-cash.num(name="countedCash" inputmode="numeric" pattern="[0-9]*" required autocomplete="off" value=closeCounted)
              label(for="close-note") Ghi chú · bắt buộc khi lệch tiền
              textarea#close-note(name="note" maxlength="500" rows="2")= closeNote
              button.btn.dark(type="submit") Xác nhận đóng ca
      #counter.staff-board.sale(data-active-order=activeOrder ? activeOrder.id : '' data-day=day)
        aside#staff-left.board-left(aria-label="Chọn suất")
          .col-head
            h2 1 · Suất
            form.day-pick(method="get")
              label
                span.sr-only Đổi ngày chiếu
                input#counter-date(type="date" name="date" value=day min=today)
          p.col-note Ngừng bán 5 phút trước giờ chiếu.
          if showGroups.size() == 0
            p.line-empty Không có suất mở bán tại rạp ngày #{dayText}. Chọn ngày khác.
          each g in showGroups
            .movie-shows
              strong= g.movieTitle
              span.meta= g.meta
              .times
                each s in g.shows
                  button.show-card(type="button" data-showtime=s.id disabled=!s.sellable aria-pressed="false" title=s.roomName + ' · ' + s.state)= s.time
              if !g.anySellable
                span.meta Hết suất bán hôm nay
        section.board-mid(aria-label="Chọn ghế")
          .col-head
            h2 2 · Ghế
            span#counter-show-label.hint Chưa chọn suất
          .screen-bar
            span MÀN HÌNH
          #counter-seat-map.seat-map(aria-label="Sơ đồ ghế")
            p.line-empty Chọn một giờ chiếu ở cột trái để xem sơ đồ ghế.
          p#counter-seat-status.hint(role="status" aria-live="polite")
          .legend(aria-label="Chú thích ghế")
            span
              i.seat-key
              | Thường
            span
              i.seat-key.vip
              | VIP
            span
              i.seat-key.couple
              | Đôi
            span
              i.seat-key.selected
              | Đang chọn
            span
              i.seat-key.mine
              | Quầy này giữ
            span
              i.seat-key.sold
              | Đã bán / nơi khác giữ
            span
              i.seat-key.maintenance
              | Bảo trì
        aside.board-right.cart(aria-label="Đơn hiện tại")
          .col-head
            h2 3 · Đơn
          #cart-select.cart-view
            #cart-picked-lines.lines
            p#cart-picked-empty.hint Chưa chọn ghế. Chọn trên sơ đồ, tối đa 8 ghế; ghế đôi bán theo cặp.
            .total-line
              span Tạm tính
              strong#cart-picked-total.zero —
            .cart-foot
              button#cart-hold.btn.primary.big(type="button" hidden) Giữ ghế · 5 phút
              button#cart-clear.btn(type="button" hidden) Bỏ chọn
              p.hint Giữ 5 phút, không gia hạn. Combo, khách hàng và tiền mặt nhập sau khi giữ.
          #cart-held.cart-view(hidden)
            .hold-line
              span#cart-order-code.mono
              span Còn
                b#cart-countdown(aria-live="off") 05:00
            .cart-scroll
              #cart-seat-lines.lines
              h3 Combo
              if products.size() == 0
                p.hint Chưa có combo đang bán.
              #cart-products.lines
                each p in products
                  .product-row(data-product=p.id data-price=p.price)
                    span
                      | #{p.name}
                      small= p.priceText
                    .stepper
                      button.step(type="button" data-step="-1" aria-label='Bớt ' + p.name) −
                      output(data-quantity) 0
                      button.step(type="button" data-step="1" aria-label='Thêm ' + p.name) +
              h3 Khách hàng
              #cart-customer
                p#customer-selected.hint Khách vãng lai · không tích điểm
                form#customer-search.inline
                  label.sr-only(for="customer-q") Số điện thoại hoặc email tài khoản
                  input#customer-q(autocomplete="off" placeholder="SĐT hoặc email")
                  button.btn(type="submit") Tìm
                #customer-results
              h3 Thu tiền mặt
              label.sr-only(for="cash-received") Khách đưa (đồng)
              .inline
                span.pre Khách đưa
                input#cash-received.num(inputmode="numeric" pattern="[0-9]*" autocomplete="off" placeholder="0")
              .quick-cash
                button(type="button" data-cash="exact") Đúng tiền
                button(type="button" data-cash="50000") +50.000
                button(type="button" data-cash="100000") +100.000
                button(type="button" data-cash="200000") +200.000
                button(type="button" data-cash="500000") +500.000
                button(type="button" data-cash="clear") Nhập lại
              .line
                span Tiền thối
                strong#cash-change —
            .total-line
              span Tổng
              strong#cart-total.zero —
            .cart-foot
              p#pay-hint.pay-hint Nhập số tiền khách đưa (hoặc bấm “Đúng tiền”) để thu tiền và phát vé.
              button#cart-pay.btn.primary.big(type="button" disabled hidden) Thu tiền và phát vé
              button#cart-release.btn(type="button") Huỷ giữ ghế
          #cart-done.cart-view(hidden)
            .verdict.ok
              i.sq
              strong Đã thu tiền
            p#done-summary.verdict-sub
            .line
              span Khách đưa
              strong#done-received
            .line
              span Tiền thối
              strong#done-change
            #done-checkin-result
            .cart-foot
              a#done-print.btn.primary.big(href="#" target="_blank" rel="noopener") In vé
              button#done-checkin.btn(type="button") Check-in luôn
              button#done-next.btn(type="button") Bán đơn mới
      dialog#orders-drawer.sheet(aria-labelledby="orders-title")
        .sheet-head
          div
            h2#orders-title Đơn trong ca ##{shift.id}
            p.hint Huỷ được trong 15 phút sau khi bán, khi chưa ai check-in và trước giờ chiếu.
          button.link(type="button" data-drawer-close) Đóng
        if orders.size() == 0
          p.line-empty Chưa có đơn nào trong ca.
        else
          table.ledger
            thead
              tr
                th Đơn
                th Lúc bán
                th Suất
                th Ghế
                th Khách
                th.num Tổng
                th Trạng thái
                th
            tbody
              each o in orders
                tr
                  td.mono= o.code
                  td= o.paid.length() > 0 ? o.paid.substring(0, 5) : '—'
                  td #{o.movieTitle} · #{o.roomName} · #{o.when.substring(0, 5)}
                  td= o.seats
                  td= o.customer
                  td.num= o.totalText
                  td
                    span.state(class=o.status == 'PAID' ? 'ok' : o.status == 'CANCELLED' ? 'void' : 'valid')= o.statusLabel
                    if o.cancelReason
                      small.hint Lý do: #{o.cancelReason}
                  td.num
                    if o.status == 'PAID'
                      a.link(href='/staff/counter/orders/' + o.id + '/print' target="_blank" rel="noopener") In lại
                    if o.cancellable
                      |  ·
                      button.link.cancel-order(type="button" data-order=o.id data-code=o.code) Huỷ đơn
      dialog#cancel-dialog.sheet.small
        form#cancel-form(method="dialog")
          h2 Huỷ đơn
          p#cancel-text
          label(for="cancel-reason") Lý do huỷ (bắt buộc)
          textarea#cancel-reason(maxlength="500" rows="3" required)
          p.hint Vé bị vô hiệu, ghế trở lại trống và tiền mặt hoàn cho khách được trừ khỏi két.
          .inline.end
            button.btn(type="button" value="cancel" data-close) Không huỷ
            button.btn.dark(type="submit" value="confirm") Huỷ đơn và hoàn tiền
