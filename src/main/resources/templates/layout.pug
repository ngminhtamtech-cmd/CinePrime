doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="description" content="CinePrime — Khám phá phim, chọn ghế và đặt vé trực tuyến.")
    meta(name="csrf-token" content=csrfToken)
    meta(name="csrf-header" content=csrfHeader)
    title= title
    link(rel="icon" href="/images/cineprime-mark.svg" type="image/svg+xml")
    link(rel="preload" href="/fonts/be-vietnam-pro-vietnamese-400-normal.woff2" as="font" type="font/woff2" crossorigin)
    link(rel="preload" href="/fonts/be-vietnam-pro-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin)
    link(rel="stylesheet" href="/css/site.css")
    script(src="/js/app.js" defer)
    block head
  body
    a.skip(href="#main") Đi đến nội dung
    .topbar
      .container
        if siteNotices && siteNotices.size() > 0
          each n in siteNotices
            a(href='/content/' + n.slug)= n.title
        else
          span Một tấm vé. Ngàn cảm xúc.
        a(href="/content/chinh-sach") Thông tin đặt vé · Hỗ trợ
    header.site-header
      .container.header-row
        a.brand(href="/" aria-label="CinePrime trang chủ")
          img.brand-symbol(src="/images/cineprime-mark.svg" alt="" width="40" height="40" aria-hidden="true")
          span Cine
            strong Prime
        a.button.ticket-link(href="/showtimes") Mua vé
        form.header-search(action="/movies" method="get" role="search")
          input(name="q" placeholder="Tìm phim theo tên" aria-label="Tìm phim")
          button(type="submit" aria-label="Tìm kiếm")
            svg.icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
              circle(cx="11" cy="11" r="7")
              path(d="M20 20l-3.6-3.6")
        .header-account
          if viewer
            a(href="/account")= viewer.name
            form(action="/logout" method="post")
              input(type="hidden" name=csrfName value=csrfToken)
              button.text-button(type="submit") Đăng xuất
          else
            a(href="/login") Đăng nhập
        button.menu-toggle(type="button" aria-expanded="false" aria-controls="navigation" aria-label="Mở menu")
          svg.icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
            path(d="M4 7h16M4 12h16M4 17h16")
    nav#navigation.site-nav(aria-label="Điều hướng chính")
      .container.nav-row
        a(href="/showtimes") Mua vé
        a(href="/movies" aria-current=currentPath && currentPath.startsWith('/movies') ? 'page' : false) Phim
        a(href="/showtimes" aria-current=currentPath == '/showtimes' ? 'page' : false) Lịch chiếu
        a(href="/offers" aria-current=currentPath == '/offers' ? 'page' : false) Khuyến mãi
        a(href="/articles" aria-current=currentPath == '/articles' ? 'page' : false) Góc điện ảnh
        a(href="/cinemas" aria-current=currentPath && currentPath.startsWith('/cinemas') ? 'page' : false) Rạp / Giá vé
        if viewer
          a(href="/account" aria-current=currentPath == '/account' ? 'page' : false) Vé của tôi
          if viewer.role == 'ADMIN'
            a(href="/admin") Quản trị
          if viewer.role == 'STAFF'
            a(href="/staff") Soát vé
          form.mobile-logout(action="/logout" method="post")
            input(type="hidden" name=csrfName value=csrfToken)
            button.text-button(type="submit") Đăng xuất
    main#main
      block content
    footer.site-footer
      .container.footer-grid
        div
          a.brand(href="/" aria-label="CinePrime trang chủ")
            img.brand-symbol(src="/images/cineprime-mark.svg" alt="" width="40" height="40" aria-hidden="true")
            span Cine
              strong Prime
          p Hơn cả một buổi xem phim.
          p Đồ án · Dữ liệu minh họa · Thanh toán sandbox
        div
          h3 CinePrime
          a(href="/content/gioi-thieu") Về chúng tôi
          a(href="/cinemas") Hệ thống rạp
          a(href="/articles") Góc điện ảnh
        div
          h3 Hỗ trợ
          a(href="/content/chinh-sach") Chính sách đặt vé
          a(href="/content/lien-he") Liên hệ
          a(href="/account") Tài khoản & vé
        div
          h3 Đặt vé
          p Chọn phim, chọn chỗ ngồi và nhận vé điện tử ngay sau khi thanh toán.
          a.button(href="/showtimes") Đặt vé ngay
      .container.copyright © 2026 CinePrime · Đồ án hệ thống đặt vé trực tuyến
    #toast(role="status" aria-live="polite")
