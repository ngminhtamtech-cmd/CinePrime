extends layout
block content
  section.container.section
    .eyebrow MỘT TRẢI NGHIỆM GẦN BẠN
    h1 Hệ thống rạp
    .content-grid
      each c in cinemas
        article.panel
          .cinema-art ✦
          small= c.city
          h2= c.name
          p= c.address
          a.button.secondary(href='/cinemas/' + c.id) LỊCH CHIẾU & GIÁ VÉ →
    if cinemas.size() == 0
      .empty Chưa có rạp đang hoạt động.
