extends layout
include mixins
block content
  section.page-header
    .container
      .eyebrow= cinema.city
      h1= cinema.name
      p #{cinema.address} · Hotline #{cinema.phone}
  section.container.section
    .section-heading
      h2 Lịch chiếu tại rạp
    +dateStrip()
    .show-list
      +showList(shows)
  section.container.section
    .section-heading
      h2 Giá vé
    p.muted Giá theo một ghế vật lý. Ghế đôi bắt buộc mua cả cặp; tổng giá cặp bằng giá hai ghế. Phụ thu riêng của suất hiển thị khi chọn ghế.
    .table-wrap
      table
        thead
          tr
            th Loại ghế
            th Ngày
            th Khung giờ
            th Giá vé / ghế
        tbody
          each p in prices
            tr
              td= p.seatType
              td= p.dayType == 'WEEKEND' ? 'Thứ Bảy / Chủ nhật' : 'Thứ Hai – Thứ Sáu'
              td= p.time
              td= p.amountText
  if cinema.description
    section.container.section
      .section-heading
        h2 Thông tin rạp
      p.prose= cinema.description
