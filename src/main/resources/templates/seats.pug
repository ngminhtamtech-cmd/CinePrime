extends layout
include mixins
block content
  .container.section
    .booking-steps
      span 01 · Chọn suất
      strong 02 · Chọn ghế
      span 03 · Combo & Thanh toán
      span 04 · Nhận vé
    .booking-grid
      .panel
        h1 Chọn chỗ ngồi của bạn
        p.muted Ghế được giữ 5 phút sau khi bấm Tiếp tục. Tối đa 8 ghế. Ghế đôi chọn cả cặp, giá hiển thị theo hai chỗ.
        .screen MÀN HÌNH
        #seat-map.seat-map(data-showtime=show.id aria-label="Sơ đồ ghế")
          p Đang tải sơ đồ ghế…
        p.muted Loại ghế
        .legend
          span Standard · Ghế thường
          span.vip VIP
          span.couple Couple · Ghế đôi
        p.muted Trạng thái ghế
        .legend
          span Còn trống
          span.selected Đang chọn
          span.sold Đã bán
          span.held Đang giữ
          span.maintenance Bảo trì
        p#seat-status(role="status" aria-live="polite")
      aside.panel.summary
        img.summary-poster(src=show.poster alt=show.movieTitle)
        h2= show.movieTitle
        p #{show.cinemaName} · #{show.roomName}
        p= show.when
        p #{show.format} · #{show.language}
        hr
        p Ghế chọn: 
          strong#selected-seats Chưa chọn
        .total
          span Tạm tính
          strong#seat-total 0 ₫
        button#hold-seats.button.full(type="button" disabled) TIẾP TỤC →
        a.back(href="/showtimes") ← Chọn suất khác
