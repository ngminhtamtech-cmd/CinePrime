extends layout
block admin
  .page-heading
    div
      h1 Đơn hàng
      p.muted Mọi đơn online và tại quầy ở một nơi · trạng thái đơn và từng lần thanh toán được theo dõi riêng.
    a.button.secondary(href="/admin/transactions.csv") ↓ Nhật ký giao dịch
  nav.channel-tabs(aria-label="Kênh bán")
    a(href='/admin/orders?cinemaId=' + cinemaId + '&date=' + day aria-current=channel == '' ? 'page' : false) Tất cả kênh
    a(href='/admin/orders?channel=ONLINE&cinemaId=' + cinemaId + '&date=' + day aria-current=channel == 'ONLINE' ? 'page' : false) Online
    a(href='/admin/orders?channel=COUNTER&cinemaId=' + cinemaId + '&date=' + day aria-current=channel == 'COUNTER' ? 'page' : false) Tại quầy
  form.ops-filters(method="get")
    input(type="hidden" name="channel" value=channel)
    label Tìm đơn
      input(name="q" value=q placeholder="Mã đơn, email, phim…")
    label Trạng thái đơn
      select(name="state")
        option(value="") Tất cả
        option(value="PAID" selected=state == 'PAID') Đã thanh toán
        option(value="PENDING_PAYMENT" selected=state == 'PENDING_PAYMENT') Chờ thanh toán
        option(value="EXPIRED" selected=state == 'EXPIRED') Hết hạn
        option(value="CANCELLED" selected=state == 'CANCELLED') Đã hủy
    label Thanh toán
      select(name="paymentState")
        option(value="") Tất cả
        option(value="RECONCILIATION" selected=paymentState == 'RECONCILIATION') Cần đối soát
        option(value="SUCCEEDED" selected=paymentState == 'SUCCEEDED') Thành công
        option(value="REFUNDED" selected=paymentState == 'REFUNDED') Đã hoàn tiền
        option(value="FAILED" selected=paymentState == 'FAILED') Có lần thất bại
        option(value="PENDING" selected=paymentState == 'PENDING') Đang xác minh
        option(value="CREATED" selected=paymentState == 'CREATED') Mới tạo
    label Rạp
      select(name="cinemaId")
        option(value="") Tất cả rạp
        each c in adminCinemas
          option(value=c.id selected=cinemaId == c.id.toString())= c.name
    label Ngày tạo đơn
      input(type="date" name="date" value=day)
    button.button(type="submit") Lọc đơn
  .order-summary(aria-label="Tổng hợp theo bộ lọc")
    div
      small Đơn khớp bộ lọc
      strong(class=total == 0 ? 'zero' : '')= total
      span Online #{summary.onlineCount} · Quầy #{summary.counterCount}
    div
      small Đã thanh toán
      strong(class=summary.paidCount == 0 ? 'zero' : '')= summary.paidCount
      span Giá trị #{summary.paidAmount}
    div
      small Chờ thanh toán
      strong(class=summary.pending == 0 ? 'zero' : '')= summary.pending
      span Đơn online đang giữ ghế / chờ MoMo
    div
      small Đã hủy
      strong(class=summary.cancelled == 0 ? 'zero' : '')= summary.cancelled
      span Gồm đơn quầy hủy và hoàn tiền mặt
  .panel
    .table-wrap
      table.management-table
        thead
          tr
            th Đơn / Khách
            th Kênh
            th Phim / Suất
            th Ngày đặt
            th Thực trả
            th Đơn
            th Thanh toán
        tbody
          each o in rows
            tr
              td(data-label="Đơn / Khách")
                a(href='/admin/orders/' + o.id)
                  strong= o.code
                small= o.customerName
                small= o.email
              td(data-label="Kênh")
                span.channel-badge(class=o.counter ? 'counter' : 'online')= o.channelLabel
                if o.counter && o.seller != ''
                  small NV: #{o.seller}
              td(data-label="Phim / Suất")
                span.cell-text= o.movieTitle
                small #{o.cinemaName} · #{o.when}
              td(data-label="Ngày đặt")= o.created
              td(data-label="Thực trả")= o.totalText
              td(data-label="Đơn")
                span.badge= o.statusLabel
              td(data-label="Thanh toán")
                span.cell-text= o.paymentLabel
    if rows.size() == 0
      .empty Không có đơn phù hợp với bộ lọc.
    +pagination()
