extends layout
block admin
  .page-heading
    div
      h1= resourceLabel
      p.muted #{total} kết quả · 5 dòng mỗi trang
    if key != 'reviews'
      if key == 'seats'
        if roomId
          a.button(href='/admin/setup/rooms/' + roomId) + Thêm / sửa ghế trên sơ đồ
        else
          button.button(type="button" disabled title="Chọn phòng trước khi thêm ghế") Chọn phòng để thêm ghế
      else if key == 'showtimes'
        a.button(href='/admin/showtimes/new?cinemaId=' + cinemaId + '&date=' + day + '&movieId=' + movieId + '&roomId=' + roomId) + Thêm suất chiếu
      else
        a.button(href='/admin/manage/' + key + '/edit?returnTo=' + returnEncoded data-dialog-form=dialogForm ? '/admin/manage/' + key + '/dialog?returnTo=' + returnEncoded : false) + Thêm mới
  if scopedCinema
    .cinema-context
      span RẠP ĐANG QUẢN LÝ
      strong= selectedCinemaName
  if key == 'showtimes'
    p
      a(href=schedulePeerLink) ← Xem lịch theo ngày với các bộ lọc này
  if key == 'users'
    nav.account-tabs(aria-label="Vai trò tài khoản")
      a(href='?state=CUSTOMER' class=state == 'CUSTOMER' ? 'active' : '' aria-current=state == 'CUSTOMER' ? 'page' : false) User
      a(href='?state=STAFF' class=state == 'STAFF' ? 'active' : '' aria-current=state == 'STAFF' ? 'page' : false) Staff
      a(href='?state=ADMIN' class=state == 'ADMIN' ? 'active' : '' aria-current=state == 'ADMIN' ? 'page' : false) Admin
  form.ops-filters(method="get" data-scope-filters=scopedCinema ? 'true' : false)
    if key == 'prices' && roomId
      input(type="hidden" name="roomId" value=roomId)
    if key == 'users'
      input(type="hidden" name="state" value=state)
    if hasCinemaFilter
      label Rạp
        select(name="cinemaId")
          if !scopedCinema
            option(value="") Tất cả rạp
          each c in adminCinemas
            option(value=c.id selected=cinemaId == c.id.toString())= c.name
    if key == 'showtimes'
      label Ngày chiếu
        input(type="date" name="date" value=day required)
      label Phim trong ngày
        select(name="movieId")
          option(value="") Tất cả phim trong ngày
          each m in filterMovies
            option(value=m.id selected=movieId == m.id.toString())= m.name
    label Tìm kiếm
      input(name="q" value=q placeholder="Tên, mã hoặc thông tin liên quan…")
    if states.size() > 0 && key != 'users'
      label Trạng thái / Loại
        select(name="state")
          option(value="") Tất cả
          each s in states
            option(value=s.value selected=state == s.value)= s.label
    if hasActivityFilter
      label Hoạt động
        select(name="activity")
          option(value="") Tất cả
          option(value="true" selected=activity == 'true') Đang hoạt động
          option(value="false" selected=activity == 'false') Đã khóa / Ngừng
    if hasRoomFilter
      label Phòng
        select(name="roomId")
          option(value="")= key == 'seats' ? '— Chọn phòng để xem ghế —' : 'Tất cả phòng'
          each r in adminRooms
            option(value=r.id selected=roomId == r.id.toString())= r.name
    if key == 'prices'
      label Loại ngày
        select(name="dayType")
          option(value="") Tất cả
          option(value="WEEKDAY" selected=dayType == 'WEEKDAY') Thứ 2–6
          option(value="WEEKEND" selected=dayType == 'WEEKEND') Thứ 7, Chủ nhật
    button.button.secondary(type="submit") Lọc kết quả
  .panel
    .table-wrap
      table.management-table
        thead
          tr
            th Mã
            each column in columns
              th= column.label
            th Thao tác
        tbody
          each row in rows
            tr
              td
                span.record-id ##{row.id}
                if row.image
                  img.record-thumb(src=row.image alt="" loading="lazy")
              each cell in row.cells
                td(data-label=cell.label)
                  if cell.badge
                    span.status-badge(class='tone-' + cell.tone)= cell.value
                  else if cell.expandable && cell.value.length() > 80
                    details.cell-details
                      summary
                        span.cell-clamp= cell.value
                        small Xem đầy đủ
                      p= cell.value
                  else
                    span.cell-text= cell.value
              td.actions-cell
                .row-actions
                  if key == 'seats'
                    a.action-btn.primary(href='/admin/setup/rooms/' + roomId + '?seatId=' + row.id) Sửa ghế
                  else
                    a.action-btn.primary(href='/admin/manage/' + key + '/edit?id=' + row.id + '&returnTo=' + returnEncoded data-dialog-form=dialogForm && key != 'reviews' ? '/admin/manage/' + key + '/dialog?id=' + row.id + '&returnTo=' + returnEncoded : false)
                      svg(viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false")
                        path(d=key == 'reviews' ? 'M20 6L9 17l-5-5' : 'M4 20h4L19 9l-4-4L4 16v4zM14 6l4 4')
                      | #{key == 'reviews' ? 'Duyệt' : 'Sửa'}
                  if key == 'cinemas'
                    a.action-btn(href='/admin/manage/rooms/edit?cinemaId=' + row.id) + Phòng
                  if key == 'rooms'
                    a.action-btn(href='/admin/setup/rooms/' + row.id) Sơ đồ ghế
                  if key == 'users'
                    a.action-btn(href='/admin/orders?q=' + row.email) Lịch sử
                  if key == 'vouchers'
                    a.action-btn(href='/admin/voucher-usage/' + row.id) Lượt dùng
                  if key == 'movies' && !row.active
                    form(action='/admin/manage/movies/' + row.id + '/restore' method="post")
                      +csrf()
                      input(type="hidden" name="returnTo" value=returnTo)
                      button.action-btn(type="submit" data-confirm='Hiện lại phim “' + row.name + '” trên website?') Hiện lại
                  if (key == 'movies' && (row.active || row.canDelete)) || (key != 'movies' && key != 'users' && row.canDisable)
                    details.row-menu
                      summary(aria-label='Thao tác khác cho ' + row.name title="Thao tác khác")
                        svg(viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false")
                          circle(cx="5" cy="12" r="1.8")
                          circle(cx="12" cy="12" r="1.8")
                          circle(cx="19" cy="12" r="1.8")
                      .row-menu-list(role="menu")
                        if key == 'movies'
                          if row.active
                            form(action='/admin/manage/movies/' + row.id + '/disable' method="post")
                              +csrf()
                              input(type="hidden" name="returnTo" value=returnTo)
                              button.menu-item.danger(type="submit" role="menuitem" data-confirm='Ẩn phim “' + row.name + '” khỏi website và dừng nhận đơn mới? Đơn còn hạn, vé đã thanh toán và check-in vẫn được giữ.') Ẩn khỏi website
                          if row.canDelete
                            form(action='/admin/manage/movies/' + row.id + '/delete' method="post")
                              +csrf()
                              input(type="hidden" name="returnTo" value=returnTo)
                              button.menu-item.danger(type="submit" role="menuitem" data-confirm='Xóa vĩnh viễn phim chưa sử dụng “' + row.name + '”? Thao tác xóa bản ghi và liên kết thể loại/đoàn phim, không thể hoàn tác từ website.') Xóa vĩnh viễn
                          else
                            p.menu-note Phim đã có lịch hoặc dữ liệu khách nên chỉ ẩn được, không xóa được.
                        else
                          form(action='/admin/manage/' + key + '/' + row.id + '/disable' method="post")
                            +csrf()
                            input(type="hidden" name="returnTo" value=returnTo)
                            button.menu-item.danger(type="submit" role="menuitem" data-confirm=(key == 'prices' ? 'Xóa khung giá ' : key == 'showtimes' ? 'Hủy suất ' : key == 'movie-genres' || key == 'credits' ? 'Gỡ liên kết ' : key == 'reviews' ? 'Ẩn bình luận ' : 'Ngừng hoạt động ') + row.name + '? Hệ thống sẽ kiểm tra dữ liệu liên quan trước khi thay đổi.')= key == 'prices' ? 'Xóa khung giá' : key == 'showtimes' ? 'Hủy suất chiếu' : key == 'movie-genres' || key == 'credits' ? 'Gỡ liên kết' : key == 'reviews' ? 'Ẩn bình luận' : key == 'cinemas' ? 'Ngừng hoạt động rạp' : key == 'rooms' ? 'Ngừng sử dụng phòng' : key == 'seats' ? 'Ngừng dùng ghế' : key == 'products' ? 'Ngừng bán' : key == 'vouchers' ? 'Ngừng mã ưu đãi' : key == 'contents' ? 'Ẩn nội dung' : 'Ngừng hoạt động'
    if rows.size() == 0
      .empty= key == 'seats' && !roomId ? 'Chọn phòng trong rạp ở trên để xem và quản lý ghế.' : 'Không có dữ liệu phù hợp. Thử đổi bộ lọc hoặc thêm bản ghi mới.'
    +pagination()
  if key == 'seats' && roomId
    .panel.actions
      a.button.secondary(href='/admin/setup/rooms/' + roomId) Sơ đồ / Bảo trì / Giá →
      a.button.secondary(href='/admin/setup/rooms/' + roomId + '?step=inventory') Trạng thái ghế theo suất →
  if key == 'prices'
    p.notice Áp dụng chung cho các phòng trong rạp này · Giá theo ghế vật lý. Không tự tạo giá khi thêm phòng.
  if key == 'products' || key == 'vouchers'
    p.notice Toàn hệ thống · Dùng tại bước combo / mã ưu đãi trong đơn hàng.
