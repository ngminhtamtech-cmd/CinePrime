extends layout
block head
  script(src="/js/admin-banner.js" defer)
block admin
  .page-heading
    div
      h1 #{banner.id ? 'Sửa banner' : 'Thêm banner'}
      p.muted Trang chủ chỉ hiển thị ảnh banner; bấm vào banner mở trang phim hoặc liên kết khuyến mãi.
    a.button.secondary(href="/admin/banners") ← Danh sách
  if formError
    .form-error(role="alert" tabindex="-1")
      strong Chưa thể lưu banner
      p= formError
  form.ops-edit-form.banner-form.banner-editor(action="/admin/banners/save" method="post" data-wide=minWidth data-framed=framedWidth)
    +csrf()
    if banner.id
      input(type="hidden" name="id" value=banner.id)
    .be-grid
      .be-main
        section.panel.be-section(aria-labelledby="be-kind-title")
          h2#be-kind-title.be-title Loại banner
          .be-kind(role="radiogroup" aria-labelledby="be-kind-title")
            label.be-kind-option
              input(type="radio" name="kind" value="MOVIE" checked=banner.kind == 'MOVIE')
              span.be-kind-text
                strong Banner phim
                small Dùng ảnh ngang của phim hoặc ảnh riêng · bấm mở trang phim
            label.be-kind-option
              input(type="radio" name="kind" value="PROMO" checked=banner.kind != 'MOVIE')
              span.be-kind-text
                strong Khuyến mãi
                small Ảnh tự thiết kế có sẵn chữ · bấm mở liên kết
          .be-fields
            .form-field(data-banner-kind="MOVIE")
              label(for="banner-movie") Phim
              select#banner-movie(name="movieId")
                option(value="") — Chọn phim —
                each m in bannerMovies
                  option(value=m.id selected=banner.movieId == m.id.toString() data-image=m.bannerImage)= m.title
            .form-field
              label(for="banner-title")
                | Tiêu đề
                span.be-optional(data-banner-kind="MOVIE")  · không bắt buộc
              input#banner-title(type="text" name="title" value=banner.title maxlength="255")
              small(data-banner-kind="MOVIE") Để trống sẽ dùng tên phim. Chỉ dùng trong trang quản trị và làm mô tả ảnh.
              small(data-banner-kind="PROMO") Mô tả ngắn nội dung ảnh, dành cho người dùng trình đọc màn hình.
            .form-field(data-banner-kind="PROMO")
              label(for="banner-link") Liên kết khi bấm
              input#banner-link(type="text" name="link" value=banner.link placeholder="/offers hoặc /content/ten-bai-viet" maxlength="255")
              small Đường dẫn trong CinePrime, bắt đầu bằng /. Để trống nếu chỉ hiển thị ảnh.
        section.panel.be-section(aria-labelledby="be-image-title")
          .be-section-head
            h2#be-image-title.be-title Ảnh banner
            button#be-clear-image.text-button(type="button" hidden) Gỡ ảnh riêng
          input#field-image(type="hidden" name="image" value=banner.image)
          .media-field.be-drop(data-target="field-image" data-kind="banner" data-video="false")
            label.be-dropzone
              input.be-file(type="file" accept="image/jpeg,image/png,image/webp")
              svg.be-drop-icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
                path(d="M12 16V4M7 9l5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3")
              strong Kéo ảnh vào đây hoặc bấm để chọn
              small JPG, PNG, WEBP · tối đa 5 MB · khuyến nghị 1920×640
            .upload-actions
              button.text-button(type="button" data-upload-retry hidden) Thử lại
              button.text-button(type="button" data-upload-cancel hidden) Bỏ lựa chọn mới
            span.upload-status(role="status") Ảnh tự tải ngay khi chọn.
          p.be-movie-note(data-banner-kind="MOVIE") Không tải ảnh riêng thì banner dùng ảnh ngang đã có trong thông tin phim.
        section.panel.be-section(aria-labelledby="be-show-title")
          h2#be-show-title.be-title Hiển thị
          label.be-switch
            input(type="checkbox" name="active" value="true" checked=banner.active role="switch")
            span.be-switch-track(aria-hidden="true")
            span Bật banner trên trang chủ
          .be-schedule(data-open=banner.startsAt || banner.endsAt ? 'true' : 'false')
            .be-schedule-row
              p#be-schedule-summary.be-schedule-summary Hiển thị ngay · không giới hạn thời gian
              button#be-schedule-toggle.text-button(type="button" aria-expanded="false" aria-controls="be-schedule-fields") Đặt lịch
            #be-schedule-fields.be-schedule-fields
              .form-field
                label(for="banner-start") Bắt đầu
                input#banner-start(type="datetime-local" name="startsAt" value=banner.startsAt step="60")
              .form-field
                label(for="banner-end") Kết thúc
                input#banner-end(type="datetime-local" name="endsAt" value=banner.endsAt step="60")
              button#be-schedule-clear.text-button(type="button") Xóa lịch
            small.be-zone Giờ Việt Nam (UTC+7).
      aside.be-preview(aria-labelledby="be-preview-title")
        .panel.be-preview-card
          h2#be-preview-title.be-title Xem trước trên trang chủ
          .be-frame(data-mode="empty")
            img#be-preview-image(alt="" hidden)
            p#be-preview-empty.be-frame-empty Chưa có ảnh
          p#be-preview-status.be-status(role="status")
          ul.be-legend
            li
              span.be-dot.is-wide
              | Rộng từ #{minWidth}px: phủ kín banner
            li
              span.be-dot.is-framed
              | Từ #{framedWidth}px: nằm giữa khung, không kéo giãn
            li
              span.be-dot.is-none
              | Nhỏ hơn hoặc ảnh dọc: không dùng được
    .form-savebar.be-savebar
      span#be-save-state.muted Chưa có thay đổi
      .actions
        a.button.secondary(href="/admin/banners") Hủy
        button.button(type="submit") Lưu banner
