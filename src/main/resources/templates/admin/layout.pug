extends ../operations
include ../mixins
mixin navIcon(id)
  svg.nav-svg(viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false")
    if id == 'overview'
      rect(x="3" y="3" width="7" height="9" rx="1.5")
      rect(x="14" y="3" width="7" height="5" rx="1.5")
      rect(x="14" y="12" width="7" height="9" rx="1.5")
      rect(x="3" y="16" width="7" height="5" rx="1.5")
    else if id == 'operations'
      rect(x="3" y="4.5" width="18" height="16" rx="2")
      path(d="M3 9.5h18M8 2.5v4M16 2.5v4M8 14h3M8 17h6")
    else if id == 'business'
      path(d="M5 3h14v18l-3-2-2 2-2-2-2 2-2-2-3 2z")
      path(d="M9 8h6M9 12h6M9 16h3")
    else if id == 'movies'
      rect(x="3" y="3" width="18" height="18" rx="2")
      path(d="M7 3v18M17 3v18M3 7.5h4M3 12h18M3 16.5h4M17 7.5h4M17 16.5h4")
    else if id == 'content'
      path(d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z")
      path(d="M14 3v6h6M8 13h8M8 17h5")
    else
      circle(cx="12" cy="12" r="3")
      path(d="M12 2.5v3M12 18.5v3M4.2 7l2.6 1.5M17.2 15.5l2.6 1.5M4.2 17l2.6-1.5M17.2 8.5l2.6-1.5")
block content
  .ops-shell
    button#sidebar-overlay(type="button" aria-label="Đóng điều hướng" hidden)
    aside#ops-sidebar.ops-sidebar(aria-label="Điều hướng quản trị")
      .sidebar-heading
        span.sidebar-title ĐIỀU HÀNH
        button#close-sidebar.icon-button(type="button" aria-label="Đóng điều hướng") ×
      .sidebar-nav
        each group in navGroups
          details.nav-group(open=group.active data-group-id=group.id data-active=group.active ? 'true' : 'false')
            summary
              span.nav-icon
                +navIcon(group.id)
              span.nav-label= group.label
            .nav-links
              each item in group.items
                a(href=item.href class=item.active ? 'active' : '' aria-current=item.active ? 'page' : false)= item.label
    main#main.ops-main
      .ops-breadcrumb
        a(href="/admin") Quản trị
        span / #{resourceLabel ? resourceLabel : title}
      if notice
        p.action-notice(role="status")= notice
      if actionError
        p.form-error(role="alert")= actionError
      block admin
