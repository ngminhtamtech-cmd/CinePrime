extends layout
block admin
  h1 Nhật ký hoạt động
  form.ops-filters(method="get")
    label Người thực hiện / Thao tác / Đối tượng
      input(name="q" value=q placeholder="Tìm nhật ký…")
    button.button.secondary(type="submit") Tìm kiếm
  .panel.table-wrap
    table
      thead
        tr
          th Thời gian
          th Người thực hiện
          th Thao tác
          th Đối tượng
      tbody
        each log in rows
          tr
            td= log.when
            td= log.actor
            td= log.action
            td= log.target
    if rows.size() == 0
      .empty Không có nhật ký phù hợp.
    +pagination()
