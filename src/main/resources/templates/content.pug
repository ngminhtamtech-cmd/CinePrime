extends layout
block content
  article.container.section.article
    a.more(href="/") ← Về trang chủ
    h1= content.title
    if content.dateText
      p.muted Đăng ngày #{content.dateText}
    if content.image
      img.article-image(src=content.image alt="")
    .prose= content.body
    if content.link
      p
        a.button(href=content.link) Xem thêm
